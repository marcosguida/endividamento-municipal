# Copie para .env (o .env é ignorado pelo git) e ajuste se precisar.
# Credenciais ou chaves que você adicionar no futuro devem ficar SÓ no .env.

ANO=2025
# DATA_DIR=/caminho/para/data
SICONFI_API_URL=https://apidatalake.tesouro.gov.br/ords/siconfi/tt/
SICONFI_WORKERS=4
# Origens liberadas no CORS, em JSON. Em produção, restrinja ao seu front-end.
CORS_ORIGINS=["*"]
